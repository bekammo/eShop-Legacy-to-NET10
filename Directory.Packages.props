<Project>

  <!--
    Central Package Management for eShop.Catalog.slnx (ADR-0006).
    Projects reference packages without a version; the version lives here, once.
    A package is added in the commit that introduces its first consumer.
    The Stage 1.2 capture tool keeps its inline version: its folder holds a Directory.Packages.props
    that stops the upward search and turns Central Package Management off.
  -->

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <!--
    Data access (ADR-0010) and migrations (ADR-0011). EF Core packages share one version, and
    dotnet-tools.json pins the dotnet-ef tool to it.
  -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.12" />
  </ItemGroup>

  <!--
    Logging (ADR-0018). Serilog.AspNetCore brings Serilog, its hosting and configuration packages, and the
    console and file sinks and the compact JSON formatter that the Serilog settings name. Serilog.Sinks.Async
    writes the console on a background thread (ADR-0027).
  -->
  <ItemGroup>
    <PackageVersion Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageVersion Include="Serilog.Sinks.Async" Version="2.1.0" />
  </ItemGroup>

  <!--
    The OpenAPI document (ADR-0020). It shares the ASP.NET Core version of the runtime it runs on.
    Swashbuckle.AspNetCore.SwaggerUI is only the UI over it, without Swashbuckle's generator (ADR-0028).
  -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
    <PackageVersion Include="Swashbuckle.AspNetCore.SwaggerUI" Version="10.2.3" />
  </ItemGroup>

  <!--
    Tests (ADR-0007). Microsoft.Testing.Extensions.CodeCoverage is the coverage extension of the test
    platform that xunit.v3 runs on (ADR-0030), and Microsoft.Testing.Extensions.GitHubActionsReport its
    report for GitHub Actions (ADR-0031). Take the releases that depend on the platform version that
    xunit.v3 brings.
  -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.11.2" />
    <PackageVersion Include="Microsoft.Testing.Extensions.GitHubActionsReport" Version="2.4.0" />
    <PackageVersion Include="Testcontainers.MsSql" Version="4.15.0" />
    <PackageVersion Include="xunit.v3" Version="4.0.1" />
  </ItemGroup>

</Project>
