<Project>
  <!--
    Stop-file (ADR-0006). NuGet imports the first Directory.Packages.props it finds walking up from the
    app. This one keeps the capture tool off Central Package Management, so its
    `#:package Microsoft.Data.SqlClient@<version>` directive keeps its inline version. It stays after
    cutover, together with docs/legacy.
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
  </PropertyGroup>
</Project>
