    "brands-get-all--accept-json": {
      "description": "List all brands, JSON requested. The first request creates and seeds the database.",
      "request": {
        "method": "GET",
        "path": "/api/brands",
        "headers": {
          "Accept": "application/json"
        },
        "body": null
      },
      "response": {
        "status": 200,
        "reasonPhrase": "OK",
        "headers": {
          "Cache-Control": "no-cache",
          "Content-Length": "138",
          "Content-Type": "application/json; charset=utf-8",
          "Expires": "-1",
          "Pragma": "no-cache",
          "Server": "Microsoft-IIS/10.0",
          "X-AspNet-Version": "4.0.30319",
          "X-Powered-By": "ASP.NET"
        },
        "body": {
          "kind": "json",
          "json": [
            {
              "Id": 1,
              "Brand": "Azure"
            },
            {
              "Id": 2,
              "Brand": ".NET"
            },
            {
              "Id": 3,
              "Brand": "Visual Studio"
            },
            {
              "Id": 4,
              "Brand": "SQL Server"
            },
            {
              "Id": 5,
              "Brand": "Other"
            }
          ]
        }
      }
    },
