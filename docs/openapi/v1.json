{
  "openapi": "3.1.1",
  "info": {
    "title": "eShop.Catalog.Api | v1",
    "version": "1.0.0"
  },
  "paths": {
    "/items/{catalogItemId}/pic": {
      "get": {
        "tags": [
          "Pictures"
        ],
        "summary": "Gets an item's picture.",
        "description": "The content type comes from the picture file's extension, such as image/png. A Range request gets the part it asks for (206), and a range outside the file a 416 without a body.",
        "operationId": "GetPicRouteTemplate",
        "parameters": [
          {
            "name": "catalogItemId",
            "in": "path",
            "description": "The item's ID.",
            "required": true,
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "400": {
            "description": "The ID is below 1.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "No item has this ID, the ID is not an integer, or the item's picture is missing.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "200": {
            "description": "The picture.",
            "content": {
              "image/png": {
                "schema": {
                  "$ref": "#/components/schemas/Stream"
                }
              }
            }
          }
        }
      }
    },
    "/api/brands": {
      "get": {
        "tags": [
          "Brands"
        ],
        "summary": "Gets every brand.",
        "description": "The brands are in ID order.",
        "responses": {
          "200": {
            "description": "The brands.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/CatalogBrandResponse"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/brands/{id}": {
      "get": {
        "tags": [
          "Brands"
        ],
        "summary": "Gets a brand.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "The brand's ID.",
            "required": true,
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": [
                "integer",
                "string"
              ],
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The brand.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CatalogBrandResponse"
                }
              }
            }
          },
          "404": {
            "description": "No brand has this ID.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "400": {
            "description": "The ID is not a 32-bit integer.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "Brands"
        ],
        "summary": "Deletes nothing.",
        "description": "The answer only says whether the brand exists.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "The brand's ID.",
            "required": true,
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": [
                "integer",
                "string"
              ],
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The brand exists. It is not deleted."
          },
          "404": {
            "description": "No brand has this ID.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "400": {
            "description": "The ID is not a 32-bit integer.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/items": {
      "get": {
        "tags": [
          "Items"
        ],
        "summary": "Gets a page of items.",
        "description": "The items are in ID order, each with its brand, its type and the URL of its picture. A page after the last is empty.",
        "parameters": [
          {
            "name": "pageSize",
            "in": "query",
            "description": "The number of items on a page, from 1 to 100.",
            "schema": {
              "maximum": 100,
              "minimum": 1,
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": [
                "integer",
                "string"
              ],
              "format": "int32",
              "default": 10
            }
          },
          {
            "name": "pageIndex",
            "in": "query",
            "description": "The index of the page, from 0.",
            "schema": {
              "maximum": 2147483647,
              "minimum": 0,
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": [
                "integer",
                "string"
              ],
              "format": "int32",
              "default": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The page.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaginatedItemsOfCatalogItemResponse"
                }
              }
            }
          },
          "400": {
            "description": "The page size or the page index is out of range, or not an integer.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Items"
        ],
        "summary": "Creates an item.",
        "description": "The API gives the item its ID, and the default picture.",
        "requestBody": {
          "description": "The item's fields.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CatalogItemRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "401": {
            "description": "The request has no access token, or one that is not valid: badly signed, expired, or issued by or for another party.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "403": {
            "description": "The access token does not have the catalog:write scope.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "201": {
            "description": "The item, as GET /api/items/{id} gives it. The Location header holds its URL.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CatalogItemResponse"
                }
              }
            }
          },
          "400": {
            "description": "The body is missing or not an item's JSON, a field breaks its rule, or no brand or type has the ID given. The errors name each field at fault.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              }
            }
          }
        },
        "security": [
          {
            "Bearer": [
              "catalog:write"
            ]
          }
        ]
      }
    },
    "/api/items/{id}": {
      "get": {
        "tags": [
          "Items"
        ],
        "summary": "Gets an item.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "The item's ID.",
            "required": true,
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": [
                "integer",
                "string"
              ],
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The item, with its brand, its type and the URL of its picture.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CatalogItemResponse"
                }
              }
            }
          },
          "404": {
            "description": "No item has this ID.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "400": {
            "description": "The ID is not a 32-bit integer.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "Items"
        ],
        "summary": "Replaces an item's fields.",
        "description": "The fields have the rules of a new item. The item keeps its ID and its picture.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "The item's ID.",
            "required": true,
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": [
                "integer",
                "string"
              ],
              "format": "int32"
            }
          }
        ],
        "requestBody": {
          "description": "The item's new fields.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CatalogItemRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "401": {
            "description": "The request has no access token, or one that is not valid: badly signed, expired, or issued by or for another party.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "403": {
            "description": "The access token does not have the catalog:write scope.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "204": {
            "description": "The item is updated."
          },
          "404": {
            "description": "No item has this ID.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "400": {
            "description": "The ID is not a 32-bit integer, the body is missing or not an item's JSON, a field breaks its rule, or no brand or type has the ID given.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              }
            }
          }
        },
        "security": [
          {
            "Bearer": [
              "catalog:write"
            ]
          }
        ]
      },
      "delete": {
        "tags": [
          "Items"
        ],
        "summary": "Deletes an item.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "The item's ID.",
            "required": true,
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": [
                "integer",
                "string"
              ],
              "format": "int32"
            }
          }
        ],
        "responses": {
          "401": {
            "description": "The request has no access token, or one that is not valid: badly signed, expired, or issued by or for another party.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "403": {
            "description": "The access token does not have the catalog:write scope.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "204": {
            "description": "The item is deleted."
          },
          "404": {
            "description": "No item has this ID.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "400": {
            "description": "The ID is not a 32-bit integer.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        },
        "security": [
          {
            "Bearer": [
              "catalog:write"
            ]
          }
        ]
      }
    },
    "/api/types": {
      "get": {
        "tags": [
          "Types"
        ],
        "summary": "Gets every item type.",
        "description": "The types are in ID order.",
        "responses": {
          "200": {
            "description": "The types.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/CatalogTypeResponse"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CatalogBrandResponse": {
        "required": [
          "Id",
          "Brand"
        ],
        "type": "object",
        "properties": {
          "Id": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "description": "The brand's ID.",
            "format": "int32"
          },
          "Brand": {
            "type": "string",
            "description": "The brand's name."
          }
        },
        "description": "A brand of catalog items."
      },
      "CatalogItemRequest": {
        "required": [
          "Name",
          "Price",
          "CatalogTypeId",
          "CatalogBrandId",
          "AvailableStock",
          "RestockThreshold",
          "MaxStockThreshold",
          "OnReorder"
        ],
        "type": "object",
        "properties": {
          "Name": {
            "maxLength": 50,
            "minLength": 0,
            "type": [
              "null",
              "string"
            ],
            "description": "The item's name."
          },
          "Price": {
            "maximum": 1000000,
            "minimum": 0,
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "null",
              "number",
              "string"
            ],
            "description": "The item's price, with at most two decimal places.",
            "format": "double"
          },
          "CatalogTypeId": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "description": "The ID of the item's type.",
            "format": "int32"
          },
          "CatalogBrandId": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "description": "The ID of the item's brand.",
            "format": "int32"
          },
          "AvailableStock": {
            "maximum": 10000000,
            "minimum": 0,
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "description": "The quantity in stock.",
            "format": "int32"
          },
          "RestockThreshold": {
            "maximum": 10000000,
            "minimum": 0,
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "description": "The stock at which the item should be reordered.",
            "format": "int32"
          },
          "MaxStockThreshold": {
            "maximum": 10000000,
            "minimum": 0,
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "description": "The most units that can be in stock at any time.",
            "format": "int32"
          },
          "OnReorder": {
            "type": [
              "null",
              "boolean"
            ],
            "description": "Whether the item is on reorder."
          },
          "Description": {
            "type": [
              "null",
              "string"
            ],
            "description": "The item's description. Optional."
          }
        },
        "description": "The fields of an item that a client writes."
      },
      "CatalogItemResponse": {
        "required": [
          "Id",
          "Name",
          "Description",
          "Price",
          "PictureUri",
          "CatalogTypeId",
          "CatalogType",
          "CatalogBrandId",
          "CatalogBrand",
          "AvailableStock",
          "RestockThreshold",
          "MaxStockThreshold",
          "OnReorder"
        ],
        "type": "object",
        "properties": {
          "Id": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "description": "The item's ID.",
            "format": "int32"
          },
          "Name": {
            "type": "string",
            "description": "The item's name."
          },
          "Description": {
            "type": [
              "null",
              "string"
            ],
            "description": "The item's description, or null."
          },
          "Price": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "description": "The item's price.",
            "format": "double"
          },
          "PictureUri": {
            "type": "string",
            "description": "The absolute URL of the item's picture."
          },
          "CatalogTypeId": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "description": "The ID of the item's type.",
            "format": "int32"
          },
          "CatalogType": {
            "description": "The item's type.",
            "$ref": "#/components/schemas/CatalogTypeResponse"
          },
          "CatalogBrandId": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "description": "The ID of the item's brand.",
            "format": "int32"
          },
          "CatalogBrand": {
            "description": "The item's brand.",
            "$ref": "#/components/schemas/CatalogBrandResponse"
          },
          "AvailableStock": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "description": "The quantity in stock.",
            "format": "int32"
          },
          "RestockThreshold": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "description": "The stock at which the item should be reordered.",
            "format": "int32"
          },
          "MaxStockThreshold": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "description": "The most units that can be in stock at any time.",
            "format": "int32"
          },
          "OnReorder": {
            "type": "boolean",
            "description": "Whether the item is on reorder."
          }
        },
        "description": "A catalog item."
      },
      "CatalogTypeResponse": {
        "required": [
          "Id",
          "Type"
        ],
        "type": "object",
        "properties": {
          "Id": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "description": "The type's ID.",
            "format": "int32"
          },
          "Type": {
            "type": "string",
            "description": "The type's name."
          }
        },
        "description": "A type of catalog items."
      },
      "HttpValidationProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          },
          "errors": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "traceId": {
            "type": "string",
            "description": "The request's ID in the W3C trace context form, 00-{trace ID}-{span ID}-{flags}. Its trace ID finds the request in the API's log."
          }
        }
      },
      "PaginatedItemsOfCatalogItemResponse": {
        "required": [
          "Data"
        ],
        "type": "object",
        "properties": {
          "ActualPage": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "description": "The index of this page, from 0.",
            "format": "int32"
          },
          "ItemsPerPage": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "description": "The page size: the most items that a page holds.",
            "format": "int32"
          },
          "TotalItems": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "description": "The number of items in the whole list.",
            "format": "int64"
          },
          "TotalPages": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "description": "The number of pages that hold the whole list, 0 for an empty list.",
            "format": "int64"
          },
          "Data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CatalogItemResponse"
            },
            "description": "The items of this page."
          }
        },
        "description": "A page of a list."
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          },
          "traceId": {
            "type": "string",
            "description": "The request's ID in the W3C trace context form, 00-{trace ID}-{span ID}-{flags}. Its trace ID finds the request in the API's log."
          }
        }
      },
      "Stream": {
        "type": "string",
        "format": "binary"
      }
    },
    "securitySchemes": {
      "Bearer": {
        "type": "http",
        "description": "An access token, a JWT, with the scope that the operation names.",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  },
  "tags": [
    {
      "name": "Pictures"
    },
    {
      "name": "Brands"
    },
    {
      "name": "Items"
    },
    {
      "name": "Types"
    }
  ]
}
