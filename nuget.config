<?xml version="1.0" encoding="utf-8"?>
<!--
  Package sources for both solutions (ADR-0006). Machine- and user-level feeds are cleared, so
  local builds and CI restore from the same place, and source mapping sends every package ID to
  nuget.org only.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
