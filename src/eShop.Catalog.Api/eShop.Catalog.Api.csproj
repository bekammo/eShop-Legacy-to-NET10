<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- TargetFramework, nullable, implicit usings and analyzers come from Directory.Build.props. -->

  <!--
    User secrets keep per-developer settings outside the repository (ADR-0009).
    The host reads them only in the Development environment.
  -->
  <PropertyGroup>
    <UserSecretsId>bd775565-2ab8-422b-829f-92585b457810</UserSecretsId>
  </PropertyGroup>

  <!--
    The XML comments of the handlers and of the request and response types describe the API in its OpenAPI
    document: ASP.NET Core's OpenAPI source generator reads them when the compiler documents the assembly
    (ADR-0029). A handler documents the parameters that a client sends, not the services that it is given,
    so a handler's missing param tags (CS1573) are not reported.
  -->
  <PropertyGroup>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1573</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="Serilog.Sinks.Async" />
    <PackageReference Include="Swashbuckle.AspNetCore.SwaggerUI" />
    <!--
      Needed by the dotnet-ef tool only (ADR-0011). Without compile assets the app cannot use its
      APIs, and PrivateAssets keeps it out of the test projects and the published app.
    -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design"
                      PrivateAssets="all"
                      IncludeAssets="runtime; build; native; contentfiles; analyzers; buildtransitive" />
  </ItemGroup>

  <!--
    The item pictures, moved here from the legacy app's Pics folder at cutover (Stage 11.2). Catalog:PicturesPath
    names the folder relative to the content root: the project folder under dotnet run and in the tests, and the
    app's own folder once it is published, so the publish copies it.
  -->
  <ItemGroup>
    <None Update="Pics\**" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="eShop.Catalog.Api.UnitTests" />
    <InternalsVisibleTo Include="eShop.Catalog.Api.IntegrationTests" />
  </ItemGroup>

</Project>
