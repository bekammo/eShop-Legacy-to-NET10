<Project>
  <!--
    Stop-file (ADR-0006). NuGet imports the first Directory.Packages.props it finds walking up from
    a project. This one keeps the legacy project off Central Package Management, so its
    PackageReference items keep their own Version metadata. Removed at cutover (Stage 11.3).
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
  </PropertyGroup>
</Project>
