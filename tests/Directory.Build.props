<Project>

  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <!-- Shared by the test projects (ADR-0007). -->

  <!--
    xUnit v3 test projects are executables that run on Microsoft.Testing.Platform (MTP).
    UseMicrosoftTestingPlatformRunner makes a direct run (the exe, dotnet run, F5) use MTP too,
    with the same options as dotnet test, instead of xUnit's own console runner.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!--
    The Stage 1.2 characterization data (docs/legacy) and the code that reads it, shared by both test
    projects: the unit tests compare the EF Core model with it, and from Stage 4.2 the integration
    tests compare a live database.
  -->
  <ItemGroup>
    <Compile Include="$(MSBuildThisFileDirectory)Shared\**\*.cs" LinkBase="Shared" />
    <None Include="$(MSBuildThisFileDirectory)..\docs\legacy\schema.json;$(MSBuildThisFileDirectory)..\docs\legacy\seed-data.json"
          LinkBase="Legacy" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
