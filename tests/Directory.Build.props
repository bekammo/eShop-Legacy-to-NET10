<Project>

  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <!-- Shared by the test projects (ADR-0007). -->

  <!--
    xUnit v3 test projects are executables that run on Microsoft.Testing.Platform (MTP).
    UseMicrosoftTestingPlatformRunner makes a direct run (the exe, dotnet run, F5) use MTP too,
    with the same options as dotnet test, instead of xUnit's own console runner.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!--
    The Stage 1.2 characterization data (docs/legacy), the Stage 4.3 baseline script and the code that
    reads them, shared by both test projects: the unit tests compare the EF Core model with the data
    and check the script, and the integration tests compare live databases and run the script.
    Shared also holds the SQL Server image name, which the integration tests run and the unit tests
    compare with compose.yaml (ADR-0014), and the catalog service contract suite, which each project runs
    against the implementations it can host (ADR-0015).
  -->
  <ItemGroup>
    <Compile Include="$(MSBuildThisFileDirectory)Shared\**\*.cs" LinkBase="Shared" />
    <None Include="$(MSBuildThisFileDirectory)..\docs\legacy\schema.json;$(MSBuildThisFileDirectory)..\docs\legacy\seed-data.json;$(MSBuildThisFileDirectory)..\docs\legacy\schema.sql;$(MSBuildThisFileDirectory)..\docs\legacy\ef6-model.edmx;$(MSBuildThisFileDirectory)..\docs\legacy\baseline.sql"
          LinkBase="Legacy" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
