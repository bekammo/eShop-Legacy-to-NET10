<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="Testcontainers.MsSql" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\eShop.Catalog.Api\eShop.Catalog.Api.csproj" />
  </ItemGroup>

  <!-- The committed OpenAPI document, which OpenApiDocumentTests compares with the one the API serves (ADR-0020). -->
  <ItemGroup>
    <None Include="..\..\docs\openapi\v1.json" Link="OpenApi\v1.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    The golden exchanges of the legacy app, which LegacyContractTests replays (ADR-0002), and the register of the
    deltas, in which that test finds each delta that it applies.
  -->
  <ItemGroup>
    <None Include="..\..\docs\legacy\contract\*.json" LinkBase="Legacy\contract" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\docs\behavior-changes.md" Link="Contract\behavior-changes.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
